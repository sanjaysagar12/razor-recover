# Razorpay TEST MODE credentials (Dashboard -> Test Mode -> Account & Settings -> API Keys)
# Test key IDs start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Anthropic API key (used in later phases for the AI recovery agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Phase 5 -- LLM layer provider config
LLM_PROVIDER=claude          # claude | gemini
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_CONFIDENCE_FLOOR=0.5
