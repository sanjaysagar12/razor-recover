# Razorpay TEST MODE credentials (Dashboard -> Test Mode -> Account & Settings -> API Keys)
# Test key IDs start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM provider config (pipeline/llm_layer.py)
LLM_PROVIDER=gemini          # claude | gemini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_CONFIDENCE_FLOOR=0.5
